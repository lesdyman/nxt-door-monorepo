{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@constants/*": ["./constants/*"],
      "@components/*": ["./components/*"],
      "@assets/*": ["./assets/*"],
      "@contexts/*": ["./contexts/*"],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts"
  ]
}
